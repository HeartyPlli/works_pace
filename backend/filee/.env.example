# .env.example
# Copy this file and name the copy ".env". Laravel reads its settings from .env.
# Lines that start with # are comments. Laravel ignores them.

# ----- The app -----
APP_NAME=Workspace
APP_ENV=local
# APP_KEY is filled in for you when you run: php artisan key:generate
APP_KEY=
# true shows detailed errors. Set it to false if you put the app online.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# ----- Database settings (MySQL) -----
# These are the normal values for XAMPP and Laragon:
# user "root" with an EMPTY password. Create the "workspace" database first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workspace
DB_USERNAME=root
DB_PASSWORD=

# ----- Where Laravel keeps small things -----
# Errors are written to storage/logs/laravel.log
LOG_CHANNEL=single
# Sessions are kept in the "sessions" table. Cache is kept in files. Background jobs run right away.
SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ----- Optional settings (mostly for a live website, see docs/10-deploy-to-railway.md) -----
# Remove the # at the start of a line to use it.
# Passwords for the two starting accounts. If not set, both are "password".
# OFFICER_PASSWORD=choose-a-strong-password
# VIEWER_PASSWORD=choose-another-strong-password
# Set to false to start with NO sample data (no fake students, resolutions, and so on).
# SEED_SAMPLE_DATA=false
# The address of your React app. Only this address may call the API (no slash at the end).
# FRONTEND_URL=https://your-frontend.up.railway.app
