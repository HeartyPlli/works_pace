{
    "name": "workspace/backend",
    "description": "The Laravel API of the Workspace app (Council Records and Error Fix Journal).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo_mysql": "*",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.5",
        "laravel/tinker": "^2.10.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
