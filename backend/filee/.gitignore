# .gitignore (backend)
# Files and folders that Git must NOT upload to GitHub.

# Downloaded packages. Anyone can download them again with: composer install
/vendor

# Your settings with passwords and the app key. Each computer has its own .env
.env

# Log files (Laravel writes its errors to storage/logs/laravel.log)
*.log

# Files Laravel makes by itself
/public/storage
/storage/*.key

# Database backups. They can hold real student names and payments.
# Never upload them to GitHub (this works even without the top folder's .gitignore).
*.sql
*.sql.gz
*.sql.zip

# Editor and system files
/.vscode
/.idea
.DS_Store
Thumbs.db
